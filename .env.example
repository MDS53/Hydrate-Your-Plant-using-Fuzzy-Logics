# Server Configuration
PORT=5001
APP_URL=http://localhost:5173

# Database (MongoDB Atlas or local. If left blank or unavailable, an in-memory/embedded instance launches automatically)
MONGODB_URI=mongodb://127.0.0.1:27017/plant_care_companion

# Authentication Secret
JWT_SECRET=plant_care_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API (Get from Google AI Studio; intelligent fallback provided if absent)
GEMINI_API_KEY=

# Weather Provider: "open-meteo" (free, default) or "openweathermap"
WEATHER_PROVIDER=open-meteo
OPENWEATHERMAP_API_KEY=

# Email / SMTP Configuration (Ethereal test accounts generated if left blank)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Plant Care Companion" <noreply@plantcare.local>

# Scheduler Interval (cron format, defaults to daily at 08:00 AM)
SCHEDULER_CRON="0 8 * * *"
